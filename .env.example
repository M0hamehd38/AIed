# copy to .env and fill in; never commit .env
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# local http only; behind https leave this out
DJANGO_SSL_REDIRECT=0
POSTGRES_PASSWORD=change-me
# optional: loads the demo courses for golzari@classyar.ir with this password
DEMO_TEACHER_PASSWORD=
# set by docker-compose; for other setups point it at Redis so live sessions work across server processes
# REDIS_URL=redis://localhost:6379/0
# speech-to-text service (Phase 3): a long random string shared by web and stt
STT_TOKEN=change-me-too
# Whisper model: small works on a CPU; medium or large-v3 need a GPU for live use
WHISPER_MODEL=small

# assistant language model (optional). Only aggregated, anonymous course figures are sent.
# LLM_PROVIDER=openrouter         # free DeepSeek V4 Flash via OpenRouter (create a free key at openrouter.ai)
# LLM_API_KEY=sk-or-...
# LLM_PROVIDER=anthropic          # Claude via the Anthropic API; key in LLM_API_KEY or ANTHROPIC_API_KEY
# LLM_MODEL=claude-opus-5-5
# LLM_PROVIDER=openai_compatible  # a model served inside the university
# LLM_BASE_URL=http://llm.internal:8000/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=
